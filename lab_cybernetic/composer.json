{
    "name": "cybernetic/cyber-site",
    "description": "Laboratorio didattico e-commerce con vulnerabilità intenzionali",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Cybernetic\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs src/",
        "cs-fix": "phpcbf src/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
